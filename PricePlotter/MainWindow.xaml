<Window x:Class="mine.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:mine" Title="Buy / Sell Price Log Viewer" Width="1200" Height="750" Background="#1E1E1E" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#444444">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                <Button x:Name="BtnResetView" Content="Reset View" Click="BtnResetView_Click" Margin="10,8" Padding="12,5" Background="#0E639C" Foreground="White" BorderThickness="0"/>
                <CheckBox x:Name="ChkAutoFitY" Content="Auto-Fit Y to Visible X" IsChecked="True" Checked="ChkAutoFitY_Changed" Unchecked="ChkAutoFitY_Changed" VerticalAlignment="Center" Margin="12,0" Foreground="#CCCCCC"/>
                <CheckBox x:Name="ChkAutoFollowLive" Content="Streaming" IsChecked="True" Checked="ChkAutoFollowLive_Changed" Unchecked="ChkAutoFollowLive_Changed" VerticalAlignment="Center" Margin="12,0" Foreground="#CCCCCC"/>
                <TextBlock Text="View:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="CmbAxisMode" SelectedIndex="0" SelectionChanged="CmbAxisMode_SelectionChanged" VerticalAlignment="Center" Width="90">
                    <ComboBoxItem Content="Compact"/>
                    <ComboBoxItem Content="Expanded"/>
                </ComboBox>
                <TextBlock Text="Snap Cursor To:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="CmbSnapTo" SelectedIndex="1" SelectionChanged="CmbSnapTo_SelectionChanged" VerticalAlignment="Center" Width="65">
                    <ComboBoxItem Content="None"/>
                    <ComboBoxItem Content="Buy"/>
                    <ComboBoxItem Content="Sell"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Rectangle Width="14" Height="3" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Buy" Foreground="#00E676" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Rectangle Width="14" Height="3" Fill="#FF5252" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Sell" Foreground="#FF5252" VerticalAlignment="Center" Margin="0,0,18,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <local:PriceChartControl x:Name="Chart" Grid.Row="1" AllowDrop="True" DragOver="Chart_DragOver" Drop="Chart_Drop"/>
    </Grid>
</Window>